.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.type-tabs {
  display: flex;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 6rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #666;
  transition: all 0.2s;
}

.type-tab.active {
  background: #5B6CFF;
  color: #fff;
  font-weight: 500;
}

.content-input {
  width: 100%;
  min-height: 180rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333;
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.tag {
  background: #EEF0FF;
  color: #5B6CFF;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
}

.preview-card {
  text-align: center;
}

.preview-area {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
}

.preview-img {
  width: 360rpx;
  height: 360rpx;
}

.barcode-placeholder {
  width: 100%;
}

.barcode-lines {
  height: 120rpx;
  background: repeating-linear-gradient(
    90deg,
    #333 0,
    #333 2rpx,
    #fff 2rpx,
    #fff 6rpx,
    #333 6rpx,
    #333 8rpx,
    #fff 8rpx,
    #fff 12rpx
  );
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.barcode-text {
  font-size: 28rpx;
  color: #333;
  letter-spacing: 2rpx;
}
