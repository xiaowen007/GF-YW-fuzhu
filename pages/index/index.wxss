/* 公告栏 */
.notice-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.notice-badge {
  background: #FFF4E6;
  color: #FF9C00;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.notice-content {
  flex: 1;
}

.notice-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  display: block;
}

/* 大分类工具：物料查询 */
.category-card {
  background: linear-gradient(135deg, #5B6CFF 0%, #7A5BFF 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(91, 108, 255, 0.28);
  color: #fff;
}

.category-card--hover {
  opacity: 0.94;
}

.category-card__head {
  display: flex;
  align-items: center;
}

.category-card__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.category-card__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.category-card__title {
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.category-card__badge {
  font-size: 20rpx;
  font-weight: 400;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
}

.category-card__desc {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.category-card__arrow {
  font-size: 44rpx;
  opacity: 0.7;
  margin-left: 12rpx;
}

.category-card__stats {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.category-card__stat {
  text-align: center;
  margin-right: 40rpx;
}

.category-card__num {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}

.category-card__label {
  font-size: 20rpx;
  opacity: 0.8;
  display: block;
  margin-top: 2rpx;
}

.category-card__quick {
  margin-left: auto;
  display: flex;
}

.category-card__quick-item {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 100rpx;
  padding: 8rpx 20rpx;
  margin-left: 12rpx;
}

/* 功能网格 */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}

/* 生成记录 */
.generate-record-card {
  background: #EEF5FF;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
}

.generate-icon {
  width: 80rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.generate-info {
  flex: 1;
}

.generate-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.generate-desc {
  font-size: 24rpx;
  color: #888;
}

.generate-arrow {
  color: #bbb;
  font-size: 44rpx;
}
