.role-card__head {
  display: flex;
  align-items: center;
}

.role-card__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.role-card__body {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}

.role-card__role {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.role-card__id {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  word-break: break-all;
}

.role-card__desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.redeem-bar {
  display: flex;
  align-items: center;
}

.redeem-bar__input {
  flex: 1;
  height: 88rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--text);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.redeem-bar__placeholder {
  color: var(--text-tertiary);
  letter-spacing: 0;
}

.redeem-bar__btn {
  width: 180rpx;
  margin-left: 16rpx;
}

.redeem-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
}

.seg {
  display: flex;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 16rpx;
}

.seg__item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 14rpx 0;
  border-radius: 12rpx;
}

.seg__item--active {
  background: var(--card);
  color: var(--primary);
  font-weight: 500;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 16rpx;
}

.form-item__label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.form-item__input {
  flex: 1;
  height: 56rpx;
  font-size: 28rpx;
  color: var(--text);
}

.form-item__placeholder {
  color: var(--text-tertiary);
}

.invite-list {
  display: flex;
  flex-direction: column;
}

.invite-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.invite-item:last-child {
  border-bottom: none;
}

.invite-item__code {
  font-size: 30rpx;
  color: var(--text);
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  letter-spacing: 2rpx;
}

.invite-item__meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.invite-item__role {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.invite-item__expiry {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-left: 12rpx;
}

.invite-item__remark {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

.invite-item__side {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.invite-item__status {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.invite-item__status--green {
  color: var(--success);
}

.invite-item__status--gray {
  color: var(--text-tertiary);
}

.invite-item__ops {
  margin-top: 10rpx;
}

.invite-item__op {
  font-size: 24rpx;
  color: var(--primary);
  margin-left: 20rpx;
}

.invite-item__op--danger {
  color: var(--danger);
}

.admin-list {
  display: flex;
  flex-direction: column;
}

.admin-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.admin-item:last-child {
  border-bottom: none;
}

.admin-item__name {
  font-size: 28rpx;
  color: var(--text);
}

.admin-item__me {
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
}

.admin-item__id {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
}

.admin-item__remove {
  font-size: 24rpx;
  color: var(--danger);
}

.admin-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.entry-list {
  display: flex;
  flex-direction: column;
}

.entry-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-item--hover {
  opacity: 0.75;
}

.entry-item__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  flex-shrink: 0;
}

.entry-item__icon--primary { background: var(--primary); }
.entry-item__icon--success { background: var(--success); }
.entry-item__icon--info { background: var(--info); }
.entry-item__icon--danger { background: var(--danger); }

.entry-item__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.entry-item__title {
  font-size: 28rpx;
  color: var(--text);
}

.entry-item__title--danger {
  color: var(--danger);
}

.entry-item__desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.entry-item__arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
}
