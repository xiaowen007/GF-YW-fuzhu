itle { font-size: 16px; font-weight: 600; color: #333; margin-bottom: 4px; }\n    .generate-desc { font-size: 13px; color: #888; }\n    .generate-arrow { margin-left: auto; color: #bbb; font-size: 24px; }\n    .tab-bar {\n      position: absolute;\n      bottom: 0;\n      left: 0;\n      right: 0;\n      height: 64px;\n      background: #fff;\n      display: flex;\n      justify-content: space-around;\n      align-items: center;\n      border-top: 1px solid #f0f0f0;\n      padding-bottom: 10px;\n    }\n    .tab { text-align: center; color: #999; }\n    .tab.active { color: #5B6CFF; }\n    .tab-icon { font-size: 24px; margin-bottom: 2px; }\n    .tab-text { font-size: 11px; }\n  "},"n4b3Bqz2vEMnIy5slIS16R":{"page-node-id":"n4b3Bqz2vEMnIy5slIS16R","type":"text","parentId":"eQskEOhkW5GmPx6e4sLkA2","children":null,"content":"\n"},"TQytzzkyTqRX8GCNnNQuAf":{"page-node-id":"TQytzzkyTqRX8GCNnNQuAf","type":"text","parentId":"dsKxRrSaPMfj8WcfrSXRP4","children":null,"content":"\n"},"4KJHelcvgSIieNYI1Mh9pb":{"page-node-id":"4KJHelcvgSIieNYI1Mh9pb","type":"element","parentId":"dsKxRrSaPMfj8WcfrSXRP4","tag":"body","children":["mDby8uUEFEQDfE04RYzN11","wLiq5vSIHrmYtPn83BhIOv","SDJofYxKafzOpeKXqgDfLN"]},"mDby8uUEFEQDfE04RYzN11":{"page-node-id":"mDby8uUEFEQDfE04RYzN11","type":"text","parentId":"4KJHelcvgSIieNYI1Mh9pb","children":null,"content":"\n  "},"wLiq5vSIHrmYtPn83BhIOv":{"page-node-id":"wLiq5vSIHrmYtPn83BhIOv","type":"element","parentId":"4KJHelcvgSIieNYI1Mh9pb","tag":"div","attributes":{"class":"phone"},"children":["VK1tlErF6dsfKg2Ldk9qXO","bwHbhdFdNiuzNAPUH0Wimt","2oikiorCvQw6rSFqtBA34H","G7gYh63DfsY7AQWjgiXRH8","TAIdw6uovlnrRxm8254LV0","AJbPmyw8qbMaWQ98WJG3e3","9qRT6bm4yaOaIfuH9ECK9r","mkHMtWpr0Kox06i2iGmXyB","E2LcAvPB9yNpplocFPMPtL"]},"VK1tlErF6dsfKg2Ldk9qXO":{"page-node-id":"VK1tlErF6dsfKg2Ldk9qXO","type":"text","parentId":"wLiq5vSIHrmYtPn83BhIOv","children":null,"content":"\n    "},"bwHbhdFdNiuzNAPUH0Wimt":{"page-node-id":"bwHbhdFdNiuzNAPUH0Wimt","type":"element","parentI