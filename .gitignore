# 依赖
node_modules/
cloudfunctions/*/node_modules/

# 密钥与敏感配置
*.key
private.key
config.json
.env
.env.*

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 日志与临时文件
*.log
.tmp/
