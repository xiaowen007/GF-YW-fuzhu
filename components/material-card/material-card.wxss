.mq-card {
  display: flex;
  align-items: flex-start;
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.mq-card--hover {
  background: var(--primary-light);
}

.mq-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: var(--bg);
  flex-shrink: 0;
}

.mq-thumb--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border);
}

.mq-thumb__text {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.mq-card__info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.mq-card__name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mq-card__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.mq-card__code {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  letter-spacing: 1rpx;
}

.mq-card__model {
  color: var(--text-tertiary);
}

.mq-card__tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}

.mq-tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  margin: 4rpx 10rpx 0 0;
}

.mq-tag--primary {
  background: var(--primary-light);
  color: var(--primary);
}

.mq-tag--info {
  background: #E6F1FB;
  color: #0C447C;
}

.mq-tag--danger {
  background: #FCEBEB;
  color: var(--danger);
}

.mq-tag--gray {
  background: var(--bg);
  color: var(--text-secondary);
}

.mq-card__fav {
  font-size: 32rpx;
  color: var(--warning);
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* 搜索命中高亮 */
.mq-hl {
  color: var(--primary);
  font-weight: 600;
  background: var(--primary-light);
  border-radius: 6rpx;
  padding: 0 4rpx;
}
