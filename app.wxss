page {
  --primary: #5B6CFF;
  --primary-light: #EEF0FF;
  --bg: #F5F7FA;
  --card: #FFFFFF;
  --text: #333333;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --border: #EEEEEE;
  --danger: #FF5B5B;
  --success: #07C160;
  --warning: #FF9C00;
  --info: #2D9CDB;

  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 16rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.9;
}

.btn-secondary {
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  text-align: center;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: var(--text-tertiary);
}

.empty-state .icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

/* 通用列表 */
.list-item {
  background: var(--card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.list-item .title {
  font-size: 30rpx;
  color: var(--text);
  margin-bottom: 8rpx;
}

.list-item .subtitle {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
